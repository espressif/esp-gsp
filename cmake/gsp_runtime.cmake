include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/gsp_features.cmake")

# Project-wide opt-in. All gsp_add_bundle()/gsp_add_assets() outputs contribute
# requirements, regardless of component/call order. Undeclared dynamic inputs
# preserve every enabled feature; NONE explicitly closes those extra inputs.
function(gsp_specialize_runtime)
    _esp_gsp_register_feature_report()
    cmake_parse_arguments(PARSE_ARGV 0 ARG "" "" "DYNAMIC_FEATURES;EXTRA_BUNDLES")
    if(ARG_UNPARSED_ARGUMENTS OR ARG_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "gsp_specialize_runtime: use DYNAMIC_FEATURES AUTO|ALL|NONE|jpeg png eaf reference vector procedural anim_deflate anim_spans and optional EXTRA_BUNDLES paths")
    endif()
    if(CMAKE_VERSION VERSION_LESS 3.19)
        message(FATAL_ERROR "gsp_specialize_runtime requires CMake 3.19 or newer")
    endif()
    if(ESP_GSP_BUILD_PREBUILT)
        message(FATAL_ERROR "gsp_specialize_runtime belongs to the consuming application, not the release archive build")
    endif()
    get_property(gsp_lib GLOBAL PROPERTY ESP_GSP_COMPONENT_LIB)
    if(NOT gsp_lib OR NOT TARGET ${gsp_lib})
        message(FATAL_ERROR "gsp_specialize_runtime: esp-gsp component target is unavailable")
    endif()
    if(NOT DEFINED ARG_DYNAMIC_FEATURES)
        set(ARG_DYNAMIC_FEATURES auto)
    endif()
    set(features "")
    foreach(feature IN LISTS ARG_DYNAMIC_FEATURES)
        string(TOLOWER "${feature}" feature)
        if(NOT feature MATCHES "^(auto|all|none|jpeg|png|eaf|reference|vector|procedural|anim_deflate|anim_spans)$")
            message(FATAL_ERROR "gsp_specialize_runtime: unknown dynamic feature '${feature}'")
        endif()
        list(APPEND features "${feature}")
    endforeach()
    list(REMOVE_DUPLICATES features)
    list(LENGTH features feature_count)
    if(feature_count GREATER 1 AND ("auto" IN_LIST features OR "all" IN_LIST features OR "none" IN_LIST features))
        message(FATAL_ERROR "gsp_specialize_runtime: AUTO, ALL and NONE cannot be combined with other features")
    endif()
    list(SORT features)
    list(JOIN features "," dynamic_features)
    get_property(configured GLOBAL PROPERTY ESP_GSP_RUNTIME_CONFIGURED)
    if(configured)
        message(FATAL_ERROR "gsp_specialize_runtime: configure once for the whole application, not once per bundle")
    endif()
    set_property(GLOBAL PROPERTY ESP_GSP_RUNTIME_CONFIGURED TRUE)
    set_property(GLOBAL PROPERTY ESP_GSP_RUNTIME_DYNAMIC_FEATURES "${dynamic_features}")
    foreach(bundle IN LISTS ARG_EXTRA_BUNDLES)
        get_filename_component(bundle "${bundle}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        set_property(GLOBAL APPEND PROPERTY ESP_GSP_RUNTIME_BUNDLES "${bundle}")
    endforeach()
    set_property(TARGET ${gsp_lib} PROPERTY ESP_GSP_RUNTIME_SPECIALIZED TRUE)
    cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL _esp_gsp_finalize_runtime)
endfunction()

function(_esp_gsp_finalize_runtime)
    get_property(gsp_lib GLOBAL PROPERTY ESP_GSP_COMPONENT_LIB)
    get_property(bundles GLOBAL PROPERTY ESP_GSP_RUNTIME_BUNDLES)
    get_property(bundle_targets GLOBAL PROPERTY ESP_GSP_RUNTIME_BUNDLE_TARGETS)
    get_property(dynamic_features GLOBAL PROPERTY ESP_GSP_RUNTIME_DYNAMIC_FEATURES)
    if(NOT bundles)
        message(FATAL_ERROR "gsp_specialize_runtime: no bundles; use gsp_add_bundle(), gsp_add_assets() or EXTRA_BUNDLES")
    endif()
    list(REMOVE_DUPLICATES bundles)
    list(SORT bundles)
    get_filename_component(gsp_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
    get_property(gspc_command GLOBAL PROPERTY ESP_GSPC_COMMAND)
    get_property(gspc_dependencies GLOBAL PROPERTY ESP_GSPC_DEPENDENCIES)
    if(NOT gspc_command)
        include("${gsp_root}/cmake/gsp_toolchain.cmake")
        esp_gsp_resolve_gspc("${gsp_root}" gspc_command gspc_dependencies gspc_source)
    endif()
    execute_process(COMMAND ${gspc_command} compatibility RESULT_VARIABLE result
        OUTPUT_VARIABLE contract ERROR_VARIABLE error)
    if(result EQUAL 0)
        string(JSON runtime_link ERROR_VARIABLE feature_error GET "${contract}" compiler_features runtime_link)
    endif()
    if(NOT result EQUAL 0 OR feature_error OR NOT runtime_link STREQUAL "1")
        message(FATAL_ERROR "gsp_specialize_runtime: this GSPC lacks runtime-link ABI 1; update/rebuild GSPC with this component and select it via GSPC_EXECUTABLE or .gspc_version. ${error}")
    endif()
    include("${gsp_root}/cmake/gsp_compatibility.cmake")
    esp_gsp_validate_gspc_compatibility("${contract}")
    get_target_property(prebuilt ${gsp_lib} ESP_GSP_PREBUILT_LIBRARY)
    if(prebuilt)
        execute_process(COMMAND "${CMAKE_NM}" -g --defined-only "${prebuilt}"
            RESULT_VARIABLE nm_result OUTPUT_VARIABLE symbols ERROR_VARIABLE nm_error)
        if(NOT nm_result EQUAL 0 OR NOT symbols MATCHES "[ \t]gsp_runtime_specialization_check_v1([\r\n]|$)")
            message(FATAL_ERROR "gsp_specialize_runtime: prebuilt runtime lacks ABI 1; update the component archive together with GSPC. ${nm_error}")
        endif()
    endif()
    get_target_property(disabled ${gsp_lib} ESP_GSP_RUNTIME_DISABLED_FEATURES)
    if(NOT disabled)
        set(disabled none)
    else()
        list(JOIN disabled "," disabled)
    endif()
    set(gen_dir "${CMAKE_BINARY_DIR}/gsp_runtime")
    set(assembly "${gen_dir}/runtime.S")
    set(report "${gen_dir}/runtime.json")
    set(source_deps "")
    if(gspc_command STREQUAL "${gsp_root}/ci/gspc-dev")
        file(GLOB_RECURSE source_deps CONFIGURE_DEPENDS "${gsp_root}/tools/gspc/*.rs"
            "${gsp_root}/tools/gspc/*/Cargo.toml")
        list(APPEND source_deps "${gsp_root}/tools/gspc/Cargo.lock" "${gsp_root}/formats/gsp_format.yaml")
    endif()
    add_custom_command(OUTPUT "${assembly}" "${report}"
        COMMAND ${gspc_command} runtime-link ${bundles} -o "${assembly}" --report "${report}"
            --dynamic-features "${dynamic_features}" --disabled-features "${disabled}"
        DEPENDS ${bundles} ${gspc_dependencies} ${source_deps}
        COMMENT "gspc: deriving application runtime capabilities"
        VERBATIM)
    add_custom_target(esp_gsp_runtime_requirements DEPENDS "${assembly}" "${report}")
    if(bundle_targets)
        add_dependencies(esp_gsp_runtime_requirements ${bundle_targets})
    endif()
    add_library(esp_gsp_runtime_link OBJECT "${assembly}")
    add_dependencies(esp_gsp_runtime_link esp_gsp_runtime_requirements)
    target_sources(${gsp_lib} INTERFACE $<TARGET_OBJECTS:esp_gsp_runtime_link>)
    target_link_libraries(${gsp_lib} INTERFACE "-Wl,-u,esp_gsp_runtime_requirements_v1")
    set_property(GLOBAL PROPERTY ESP_GSP_RUNTIME_FINALIZED TRUE)
    message(STATUS "esp-gsp: runtime specialization; dynamic inputs=${dynamic_features}; feature reasons -> ${report}")
endfunction()
